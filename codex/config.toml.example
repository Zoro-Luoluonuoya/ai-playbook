# Codex CLI 配置示例
# 用法：把需要的段落合并进 ~/.codex/config.toml（或项目级 .codex/config.toml），不要整文件覆盖。
# 字段名以官方文档为准；本文按 2026 年公开资料整理，键名变了只改壳子，语义不变。

[features]
# 开启多代理：模型判断"并行能显著提升速度或质量"时会自己派分身。
# 不开也能手动 /subagent，开了才会自动。
multi_agent = true

[agents]
# 并行线程上限。
# 别一上来拉满：从 2 开始跑几次，确认任务真的互不相交，再逐步加。
# 加太快的结果是——你分不清哪条改动是哪个分身带来的。
max_threads = 4

# 嵌套深度：固定 1。子代理不能再派子代理。
# 两层之后你无法追溯结论来源，出问题只能全部推倒。
max_depth = 1
